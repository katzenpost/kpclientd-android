set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

dependency_version() {
    local name=$1
    local value

    value=$(awk -F= -v name="${name}" '$1 == name { print $2 }' "${ROOT}/dependencies.txt")
    if [[ -z "${value}" ]]; then
        printf 'Missing %s version in dependencies.txt\n' "${name}" >&2
        exit 1
    fi
    printf '%s\n' "${value}"
}

GO_VERSION=${GO_VERSION:-$(dependency_version go)}
KATZENPOST_VERSION=${KATZENPOST_VERSION:-$(dependency_version katzenpost)}
ANDROID_NDK_ROOT=${ANDROID_NDK_ROOT:-${ANDROID_NDK_HOME:-/usr/lib/android-sdk/ndk/28.0.13004108}}
KATZENPOST_REPO=${KATZENPOST_REPO:-/usr/local/src/katzenpost}
export GOTOOLCHAIN=${GOTOOLCHAIN:-${GO_VERSION}}

ARCH=${1:-arm64}
case "${ARCH}" in
    arm64) ABI=arm64-v8a ;;
    amd64) ABI=x86_64 ;;
    *) ABI=${ARCH} ;;
esac
# The app runs the daemon from its native library directory, so it ships as a library.
OUT=${OUTPUT:-${ROOT}/apk/app/src/main/jniLibs/${ABI}/libkpclientd.so}
GO_BUILD_ARGS=(-mod=readonly -trimpath -buildvcs=false)

if [[ ! -d "${KATZENPOST_REPO}/.git" ]]; then
    printf 'Katzenpost repository not found: %s\n' "${KATZENPOST_REPO}" >&2
    exit 1
fi

actual_go_version=$(go env GOVERSION)
if [[ "${actual_go_version}" != "${GO_VERSION}" ]]; then
    printf 'Go version mismatch: expected %s, found %s\n' \
        "${GO_VERSION}" "${actual_go_version}" >&2
    exit 1
fi

expected_commit=$(git -C "${KATZENPOST_REPO}" rev-parse --verify "${KATZENPOST_VERSION}^{commit}")
actual_commit=$(git -C "${KATZENPOST_REPO}" rev-parse --verify HEAD)
if [[ "${actual_commit}" != "${expected_commit}" ]]; then
    printf 'Katzenpost revision mismatch: expected %s (%s), found %s\n' \
        "${KATZENPOST_VERSION}" "${expected_commit}" "${actual_commit}" >&2
    exit 1
fi

case "${ARCH}" in
    arm64)
        NDK_CC=${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android34-clang
        ;;
    amd64)
        NDK_CC=${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android28-clang
        GO_BUILD_ARGS+=(-buildmode=pie)
        export CGO_LDFLAGS=-Wl,--allow-shlib-undefined
        # The sqisign binding links a library built against glibc on any linux/amd64, Android
        # included, where it cannot link. Build against a copy of it whose build tags leave
        # Android out, so that Android takes the binding's pure Go fallback.
        SQISIGN=github.com/katzenpost/sqisign/bindings/go
        if sqisign_dir=$(cd "${KATZENPOST_REPO}" && GOOS=android GOARCH=amd64 go list -m -f '{{.Dir}}' "${SQISIGN}" 2>/dev/null); then
            patched=$(mktemp -d)
            trap 'rm -rf -- "${patched}"' EXIT
            cp -r "${sqisign_dir}/." "${patched}/mod"
            chmod -R u+w "${patched}/mod"
            sed -i -e 's#^//go:build linux && amd64$#//go:build linux \&\& amd64 \&\& !android#' \
                -e 's#^//go:build !linux || !amd64$#//go:build !linux || !amd64 || android#' \
                "${patched}"/mod/sqisign/*.go
            cp "${KATZENPOST_REPO}/go.mod" "${KATZENPOST_REPO}/go.sum" "${patched}/"
            printf 'replace %s => %s\n' "${SQISIGN}" "${patched}/mod" >> "${patched}/go.mod"
            GO_BUILD_ARGS+=(-modfile="${patched}/go.mod")
        fi
        ;;
    *)
        printf 'Unsupported architecture: %s\n' "${ARCH}" >&2
        exit 1
        ;;
esac

if [[ ! -x "${NDK_CC}" ]]; then
    printf 'Android NDK compiler not found: %s\n' "${NDK_CC}" >&2
    exit 1
fi

mkdir -p "$(dirname -- "${OUT}")"
rm -f -- "${OUT}"

(
    cd "${KATZENPOST_REPO}"
    go mod verify
    CGO_ENABLED=1 GOOS=android GOARCH="${ARCH}" CC="${NDK_CC}" \
        go build "${GO_BUILD_ARGS[@]}" \
        -ldflags="-s -w -buildid= -extldflags=-Wl,--build-id=none" \
        -o "${OUT}" ./cmd/kpclientd
)

ls -l -- "${OUT}"
